[Unit]
Description=ContentProof single-host application and private reference chain
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=contentproof
Group=contentproof
WorkingDirectory=/opt/contentproof/current/app
EnvironmentFile=/etc/contentproof/app.env
ExecStart=/opt/contentproof/current/runtime/bin/node scripts/start-app.mjs --built
Restart=on-failure
RestartSec=5
TimeoutStopSec=75
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/contentproof /var/log/contentproof
MemoryHigh=900M
MemoryMax=1200M
MemorySwapMax=512M
TasksMax=128
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
