# KV v2 adoption of existing keys: remove conflicting *_FILE/raw providers.
# Configure NODE_EXTRA_CA_CERTS before starting Node if using a private CA.
VAULT_ADDR=https://vault-1.example.invalid:8200
VAULT_TOKEN_FILE=/run/contentproof-vault/token
VAULT_KV_MOUNT=secret
STORAGE_KEY_VAULT_PATH=contentproof/storage
STORAGE_KEY_VAULT_VERSION=1
RELAYER_PRIVATE_KEY_VAULT_PATH=contentproof/relayer
RELAYER_PRIVATE_KEY_VAULT_VERSION=1
