{
  "name": "contentproof",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --import tsx scripts/start-app.mjs",
    "dev:demo": "node --import tsx scripts/start-app.mjs --demo",
    "chain": "tsx scripts/persistent-chain.ts",
    "deploy": "tsx scripts/deploy.ts",
    "api": "tsx apps/api/main.ts",
    "web": "vite --config apps/web/vite.config.ts",
    "build": "tsx scripts/openapi.ts && tsc --noEmit && tsc -p tsconfig.server.json && vite build --config apps/web/vite.config.ts",
    "start": "node dist/server/apps/api/main.js",
    "start:local": "node scripts/start-app.mjs --built",
    "maintenance": "tsx scripts/maintenance.ts",
    "test:reliability": "tsx scripts/test-reliability.ts",
    "test:audit-fixes": "tsx scripts/test-audit-fixes.ts",
    "test:permissions": "tsx scripts/test-permissions.ts",
    "test:demo-engine": "tsx scripts/test-demo-engine.ts",
    "test:node-upgrade": "tsx scripts/test-node-upgrade.ts",
    "bench:protocol": "tsx scripts/scale-protocol.ts",
    "openapi": "tsx scripts/openapi.ts",
    "deploy:init": "node scripts/init-deploy.mjs",
    "chain:qbft": "tsx scripts/qbft-network.ts",
    "test:qbft": "tsx scripts/test-qbft.ts",
    "test:rpc-failover": "tsx scripts/test-rpc-failover.ts",
    "test:media-vectors": "tsx scripts/media-vectors.ts",
    "test:codecs": "tsx scripts/codec-vectors.ts",
    "test:faults": "tsx scripts/test-faults.ts",
    "test:vault": "tsx scripts/test-vault.ts",
    "test:reorg": "tsx scripts/test-reorg-branches.ts",
    "test:media-boundaries": "tsx scripts/test-media-boundaries.ts",
    "setup:c2pa": "node scripts/install-c2pa.mjs",
    "setup:c2pa-fixtures": "node scripts/install-c2pa-fixtures.mjs",
    "test:c2pa": "tsx scripts/test-c2pa.ts",
    "test:partition": "tsx scripts/test-partition.ts",
    "bench:local": "tsx scripts/bench-local.ts",
    "soak:start": "node scripts/soak-control.mjs start",
    "soak:status": "node scripts/soak-control.mjs status",
    "soak:stop": "node scripts/soak-control.mjs stop",
    "soak:archive": "node scripts/soak-control.mjs archive",
    "test:capacity": "tsx scripts/test-capacity.ts",
    "licenses": "node scripts/licenses.mjs",
    "licenses:fetch": "node scripts/fetch-license-texts.mjs",
    "verify:built": "node dist/server/apps/verifier/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:recovery": "tsx scripts/recovery.ts",
    "test:business": "tsx scripts/test-business.ts",
    "test:config": "tsx scripts/test-config.ts",
    "verify": "tsx apps/verifier/main.ts",
    "demo": "tsx scripts/demo.ts",
    "bench": "tsx experiments/run.ts",
    "doctor": "node scripts/doctor.mjs",
    "source:index": "node scripts/source-index.mjs",
    "package:cloud": "tsx scripts/package-cloud.ts",
    "release": "tsx scripts/release.ts",
    "format": "prettier --write \"{apps,packages,scripts,experiments,test,configs}/**/*.{ts,tsx,mjs,cjs,css,json,html}\" package.json tsconfig.json hardhat.config.ts vitest.config.ts",
    "format:check": "prettier --check \"{apps,packages,scripts,experiments,test,configs}/**/*.{ts,tsx,mjs,cjs,css,json,html}\" package.json tsconfig.json hardhat.config.ts vitest.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@openzeppelin/contracts": "5.4.0",
    "@xyflow/react": "^12.0.0",
    "canonicalize": "^2.1.0",
    "fastify": "^5.0.0",
    "fflate": "^0.8.2",
    "@ganache/core": "0.10.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "sharp": "0.35.5",
    "solc": "0.8.38",
    "viem": "^2.0.0",
    "yauzl": "^3.2.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "secp256k1@^4.0.0": "4.0.4",
    "ws@^8.0.0": "8.21.0",
    "ws@^7.0.0": "7.5.11",
    "solc": {
      "tmp": "0.2.7"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.0.0",
    "fast-check": "^4.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "5.0.5"
  }
}
