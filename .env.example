# User-signed local private deployment. Values below are examples, not loaded automatically.
HOST=127.0.0.1
PORT=3001
# Only trust your controlled reverse proxy; leave unset for direct connections.
# TRUSTED_PROXIES=127.0.0.1/32
# STORAGE_MIN_FREE_BYTES=536870912 (persistent local warning below 512MiB)
# Cloud backup retention: preview by default; explicitly opt in after reviewing policy.
# BACKUP_RETENTION_DAYS=30
# BACKUP_MIN_COPIES=7
# BACKUP_PRUNE=true
## Small-server media budget; defaults are 2 workers and 8 queued jobs.
# MEDIA_CONCURRENCY=1
# MEDIA_QUEUE_LIMIT=4
RPC_URL=http://127.0.0.1:8545
# RPC_URLS=http://127.0.0.1:8576,http://127.0.0.1:8577 (trusted alternatives, maximum 5 endpoints including primary)
# CHAIN_MODE=external (never start a substitute local chain)
DATA_DIR=./data/app
DEMO_MODE=false
WEB_PORT=5173
CHAIN_ID=31337
CONFIRMATIONS=1
# External deployments must configure STORAGE_KEY (64 hex characters),
# RELAYER_PRIVATE_KEY, AUTH_AUDIENCE, ALLOWED_ORIGINS and registration policy.
# REGISTRATION_MODE=closed disables self enrollment; local loopback defaults to open.
# OPERATOR_ADDRESSES=0x... (comma-separated reviewer wallets; self-review forbidden)
# CP_BACKUP_PASSWORD=<16+ chars, only set for offline maintenance backup/restore>
# STORAGE_KEY_FILE=/run/secrets/storage_key (start:local / container supervisor)

# Version-pinned read-only Vault KV v2 (choose one provider per key; see docs/VAULT.md)
# VAULT_ADDR=https://vault.example.org
# VAULT_TOKEN_FILE=/run/secrets/contentproof_vault_token
# VAULT_KV_MOUNT=secret
# STORAGE_KEY_VAULT_PATH=contentproof/storage
# STORAGE_KEY_VAULT_VERSION=1
# RELAYER_PRIVATE_KEY_VAULT_PATH=contentproof/relayer
# RELAYER_PRIVATE_KEY_VAULT_VERSION=1

# Rotatable KV v2 reference; choose this instead of the direct PATH/VERSION pair
# STORAGE_KEY_VAULT_REF_FILE=/run/config/storage.ref.json
# Wrapped 256-bit data key for a new deployment; choose one provider per key
# STORAGE_KEY_VAULT_TRANSIT_FILE=/run/config/storage.envelope.json
# VAULT_TRANSIT_MOUNT=transit
# VAULT_TRANSIT_KEY=contentproof-storage

# Native embedded-offline C2PA verification (optional; see docs/C2PA.md)
# CP_C2PA_INSTALL_DIR=/run/c2pa-install
# CP_C2PA_TRUST_ANCHORS_FILE=/run/config/c2pa-anchors.pem
